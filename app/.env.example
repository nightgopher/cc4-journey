DB_HOST=localhost
DB_PORT=5433
DB_NAME=callcenter_db
DB_USER=root
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
HOST=127.0.0.1
PORT=3101
UPLOAD_DIR=uploads
BUSINESS_TIMEZONE=Asia/Shanghai
ENABLE_CRON=true

# Optional: DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgres://user:password@localhost:5433/database
# GOOKI_HOST=https://your-call-service.example
# GOOKI_USERNAME=
# GOOKI_PASSWORD=
# Optional: OCR runs only on the server. Never use a VITE_* variable for this key.
# PADDLEOCR_API_KEY=
# PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# MCP_HTTP_ADDR=127.0.0.1:3102
# Main server exposes /mcp only when a separate integration credential is set.
# MCP_TOKEN=
# MCP_ALLOWED_ORIGINS=https://your-server.example
